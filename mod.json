{
  "geode": "5.10.1",
  "gd": {
    "android": "2.2081",
    "win": "2.2081",
    "mac": "2.2081",
    "ios": "2.2081"
  },
  "id": "pan.icon-chance-randomizer",
  "name": "Icon Chance Randomizer",
  "version": "v1.0.0",
  "developer": "Pan5430",
  "description": "Weighted cube randomization with More Icons support.",
  "links": {
    "source": "https://github.com/Pan5430/Icon-Chance-Randomizer"
  },
  "license": "MIT",
  "tags": [
    "offline",
    "customization",
    "interface"
  ],
  "dependencies": {
    "hiimjustin000.more_icons": {
      "version": "=v2.1.3",
      "required": true
    }
  },
  "settings": {
    "enabled": {
      "name": "Enabled",
      "description": "Randomize the cube when a level starts.",
      "type": "bool",
      "default": true
    },
    "pool": {
      "name": "Cube chance pool",
      "description": "Comma-separated entries: vanilla:ID=weight or custom:NAME=weight.",
      "type": "string",
      "default": "vanilla:1=1,vanilla:2=1,vanilla:3=1"
    },
    "randomize_on_restart": {
      "name": "Randomize on restart",
      "description": "Choose a new cube whenever a level is initialized, including retries.",
      "type": "bool",
      "default": true
    },
    "debug": {
      "name": "Debug logging",
      "description": "Write parsed pool entries and invalid icons to the Geode log.",
      "type": "bool",
      "default": false
    }
  },
  "issues": "https://github.com/Pan5430/icon-chance-randomizer/issues"
}
